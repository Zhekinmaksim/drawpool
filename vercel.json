{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/frontend/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/frontend/app.js"
    },
    {
      "source": "/config.js",
      "destination": "/frontend/config.js"
    },
    {
      "source": "/abi.js",
      "destination": "/frontend/abi.js"
    },
    {
      "source": "/panel.jsx",
      "destination": "/frontend/panel.jsx"
    },
    {
      "source": "/tweaks-panel.jsx",
      "destination": "/frontend/tweaks-panel.jsx"
    }
  ]
}
